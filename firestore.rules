rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────
    // Helpers
    // ─────────────────────────────────────────────────────────────

    // Signed-in Firebase Auth user.
    function isSignedIn() {
      return request.auth != null;
    }

    // Caller's Firestore user profile. Caller must be signed in.
    function callerProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Caller is signed in, has a profile, the profile is ACTIVE, and the role
    // matches. Checking `active` here means deactivated users lose write
    // access too, not just read access.
    function hasRole(role) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && callerProfile().data.active == true
        && callerProfile().data.role == role;
    }

    function isAdmin()   { return hasRole('admin'); }
    function isTeacher() { return hasRole('teacher'); }
    function isBursar()  { return hasRole('bursar'); }

    // Signed-in, active staff (admin / teacher / bursar).
    function isStaff() {
      return isAdmin() || isTeacher() || isBursar();
    }

    // Only these role values are ever allowed on a user profile.
    function validRole() {
      return request.resource.data.role in ['admin', 'teacher', 'bursar'];
    }

    // True while the very first admin has not been created yet
    // (config/setup does not exist).
    function setupNotDone() {
      return !exists(/databases/$(database)/documents/config/setup);
    }

    function setupDone() {
      return exists(/databases/$(database)/documents/config/setup);
    }

    // First-admin exception: while setup is not done, a signed-in user may
    // create their own users/{uid} profile with role admin.
    // `userId` is passed in because it only exists inside the users match.
    function isFirstAdminCreate(userId) {
      return setupNotDone()
        && isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'admin';
    }

    // On update, the fields `role` and `active` are admin-only.
    function touchesProtectedFields() {
      return request.resource.data.diff(resource.data)
        .affectedKeys().hasAny(['role', 'active']);
    }

    // ─────────────────────────────────────────────────────────────
    // SCHOOL SETTINGS: config/app_config + config/setup
    // ─────────────────────────────────────────────────────────────
    match /config/{doc} {
      allow read: if isStaff() || doc == 'app_config' || doc == 'setup';

      allow create: if doc == 'app_config' && isAdmin();
      allow update: if doc == 'app_config' && isAdmin() && setupDone();

      allow create: if doc == 'setup' && isSignedIn() && setupNotDone();
    }

    // GRADING SETTINGS: config/grading_settings
    match /config/grading_settings {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // USER ACCOUNTS: users/{userId}
    // ─────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isStaff();

      allow create: if (isAdmin() && validRole())
        || isFirstAdminCreate(userId);

      allow update: if (isAdmin() && validRole())
        || (isStaff()
            && request.auth.uid == userId
            && !touchesProtectedFields());

      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // ACADEMIC DATA
    // ─────────────────────────────────────────────────────────────

    // Admin-only create/update (manual add + SchoolPay import; client-chosen
    // doc IDs are allowed). Students are never deleted, only set inactive.
    match /students/{studentId} {
      allow read: if isStaff();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /exam_results/{resultId} {
      allow read: if isStaff();
      allow create, update: if isAdmin() || isTeacher();
      allow delete: if isAdmin();
    }

    match /exams/{examId} {
      allow read: if isStaff();
      allow create, update: if isAdmin() || isTeacher();
      allow delete: if isAdmin();
    }

    match /projectWork/{pwId} {
      allow read: if isStaff();
      allow create, update: if isAdmin() || isTeacher();
      allow delete: if isAdmin();
    }

    match /attendance/{attendanceId} {
      allow read: if isStaff();
      allow create, update: if isAdmin() || isTeacher();
      allow delete: if isAdmin();
    }

    match /classes/{classId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /subjects/{subjectId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // STAFF RECORDS: staff/{staffId}
    // ─────────────────────────────────────────────────────────────
    match /staff/{staffId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // FINANCE
    // ─────────────────────────────────────────────────────────────
    match /fee_structures/{feeId} {
      allow read: if isStaff();
      allow write: if isAdmin() || isBursar();
    }

    match /fee_payments/{paymentId} {
      allow read: if isStaff();
      allow create, update: if isAdmin() || isBursar();
      allow delete: if isAdmin();
    }

    // Payroll and expenses: admin and bursar only (teachers excluded).
    match /payroll/{payrollId} {
      allow read, write: if isAdmin() || isBursar();
    }

    match /expenses/{expenseId} {
      allow read, write: if isAdmin() || isBursar();
    }

    // ─────────────────────────────────────────────────────────────
    // DEFAULT: deny everything not explicitly allowed above
    // ─────────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
